# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Server
PORT=3001
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Client — leave blank for local dev (Vite proxies /api to the server above).
# Set to the API's public URL only for production builds, e.g. https://api.example.com
VITE_API_URL=
